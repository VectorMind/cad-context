---
// Rendered from `cadctx generators`; the app owns no second registry.
import Layout from '../layout/Layout.astro';
import { listGenerators } from '../server/cadctx.ts';
import { effectiveExposure } from '../server/exposure.ts';

export const prerender = false;

let generators: Awaited<ReturnType<typeof listGenerators>> = [];
let error: string | null = null;
try {
  generators = await listGenerators();
} catch (cause) {
  error = cause instanceof Error ? cause.message : String(cause);
}
const projectGenerators = generators.filter((generator) => generator.origin === 'project');
const groups = [
  { title: 'Built-in generators', generators: generators.filter((g) => g.origin === 'builtin') },
  ...(projectGenerators.length > 0
    ? [{ title: `Project · ${projectGenerators[0]!.project}`, generators: projectGenerators }]
    : []),
];
---

<Layout title="Shapes" command="uv run cadctx web">
  <div class="home">
    <h1>Generated shapes</h1>
    <p class="lede">
      Pick a generator, move a few parameters, watch the shape regenerate. Every
      page talks to the Python side through <code>cadctx</code>; nothing here
      holds a second copy of the geometry logic.
    </p>

    {error && <p class="error">cadctx failed: {error}</p>}

    <a class="card featured" href="/airfoil">
      <h2>Airfoil + wing loft</h2>
      <p class="meta"><span class="tag">2d + 3d</span> shapely · build123d</p>
      <p class="knobs">
        One panel, two shapes: the NACA profile plotted from its coordinates and
        the same profile lofted into a wing with the maintained build123d backend.
      </p>
    </a>

    {
      groups.map((group) => (
        <>
          <h2 class="section">{group.title}</h2>
          <div class="cards">
            {group.generators.map((generator) => {
              const editable = effectiveExposure(generator).editable;
              return (
                <a
                  class:list={['card', { unavailable: !generator.available }]}
                  href={`/viewer/${generator.id}`}
                >
                  <h2>{generator.title}</h2>
                  <p class="meta">
                    <span class="tag">{generator.kind}</span> {generator.backend} ·{' '}
                    {generator.formats.join(', ')}
                    {!generator.available && ' · backend not installed'}
                  </p>
                  <p class="knobs">
                    {editable.length > 0 ? (
                      <>
                        editable: <code>{editable.join(', ')}</code>
                      </>
                    ) : (
                      'preview only — no parameters exposed'
                    )}
                  </p>
                </a>
              );
            })}
          </div>
        </>
      ))
    }
  </div>
</Layout>
