---
import Layout from '../../../layout/Layout.astro';
import ModelView from '../../../components/ModelView.tsx';
import { listGenerators, projectInfo } from '../../../server/cadcon.ts';
export const prerender = false;
const project = await projectInfo();
if (project.id !== Astro.params.project) return new Response('Start the viewer with this project selected for local work', {status:404});
const generators = (await listGenerators()).filter((g) => g.origin === 'project');
const portfolio = { files: (project.working_files ?? []).map(path => ({path,available:true})) };
const fileUrl = (path: string) => `/projects/${project.id}/working/` + path.split('/').map(encodeURIComponent).join('/');
const images = portfolio?.files.filter((f) => f.available && /\.(svg|png|jpe?g|webp)$/i.test(f.path)) ?? [];
const reports = portfolio?.files.filter((f) => f.available && /\.(json|pdf)$/i.test(f.path)) ?? [];
---
<Layout title={project.name ?? 'Project'} crumb="Local working models">
  <div class="portfolio">
    <p><a href={`/projects/${project.id}`}>Published project</a> · Local cache working outputs</p><h1>{project.name ?? 'No active project'}</h1>
    <p>{project.description}</p>
    <nav><a href="#models">Models</a> Â· <a href="#drawings">Drawings and evidence</a></nav>
    <h2 id="models">Models</h2>
    <div class="review-grid">
      {generators.map((g) => <section class="review-card">
        <h3>{g.kind === '2d' || g.formats.includes('glb') || g.formats.includes('stl') ? <a href={`/viewer/${g.id}`}>{g.title}</a> : g.title}</h3>
        {g.description && <p>{g.description}</p>}
        {g.formats.includes('glb') && <div class="model"><ModelView client:visible url={`/api/artifact/${g.id}/${g.id}.glb`} format="glb" wireframe={false} showGrid={false} fitToken={0} /></div>}
        <p>{g.formats.map((format) => <a class="download" href={`/api/artifact/${g.id}/${g.id}.${format}`}>{format.toUpperCase()}</a>)}</p>
      </section>)}
    </div>
    <h2 id="drawings">Drawings and evidence</h2>
    <p>Project renders, sketches and reference images. Concepts and earlier reviews do not indicate current model approval.</p>
    {reports.length > 0 && <p>{reports.map((f) => <a class="download" href={fileUrl(f.path)} target="_blank">{f.path.split('/').pop()}</a>)}</p>}
    <div class="review-grid">{images.map((f) => <figure><a href={fileUrl(f.path)} target="_blank"><img src={fileUrl(f.path)} alt={f.path.split('/').pop()} loading="lazy" /></a><figcaption>{f.path}</figcaption></figure>)}</div>
  </div>
</Layout>
<style>
  .portfolio { width: 100%; max-width: 1440px; margin: auto; padding: clamp(14px, 3vw, 28px); }
  nav { margin: 24px 0; } h2 { margin-top: 40px; scroll-margin-top: 24px; }
  .review-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(min(100%,360px),1fr)); gap: 20px; align-items: start; }
  .review-card, figure { min-width: 0; margin: 0; padding: 16px; border: 1px solid #586477; border-radius: 12px; }
  .model { height: 360px; position: relative; }
  .model :global(.viewport) { width: 100%; height: 100%; min-height: 0; }
  .download { display: inline-block; margin-right: 18px; }
  img { display: block; width: 100%; height: 280px; object-fit: contain; background: white; }
  figcaption { overflow-wrap: anywhere; margin-top: 10px; font-size: .85rem; }
</style>


