---
import Layout from '../../layout/Layout.astro';
import ModelView from '../../components/ModelView.tsx';
import { listGenerators, projectInfo } from '../../server/cadctx.ts';
export const prerender = false;
const project = await projectInfo();
const generators = (await listGenerators()).filter((g) => g.origin === 'project');
const portfolio = project.portfolio;
const fileUrl = (path: string) => '/project/files/' + path.split('/').map(encodeURIComponent).join('/');
const images = portfolio?.files.filter((f) => f.available && /\.(svg|png|jpe?g|webp)$/i.test(f.path)) ?? [];
---
<Layout title={project.name ?? 'Project'} crumb="Project portfolio">
  <div class="portfolio">
    <h1>{project.name ?? 'No active project'}</h1>
    <p>{project.description}</p>
    <nav><a href="#models">Models</a> · <a href="#drawings">Drawings and evidence</a> · <a href="#portfolio">Project portfolio</a></nav>
    <h2 id="models">Models</h2>
    <div class="review-grid">
      {generators.map((g) => <section class="review-card">
        <h3><a href={`/viewer/${g.id}`}>{g.title}</a></h3>
        {g.formats.includes('glb') && <div class="model"><ModelView client:visible url={`/api/artifact/${g.id}/${g.id}.glb`} format="glb" wireframe={false} showGrid={false} fitToken={0} /></div>}
        <p>{g.formats.map((format) => <a class="download" href={`/api/artifact/${g.id}/${g.id}.${format}`}>{format.toUpperCase()}</a>)}</p>
      </section>)}
    </div>
    <h2 id="drawings">Drawings and evidence</h2>
    <div class="review-grid">{images.map((f) => <figure><a href={fileUrl(f.path)} target="_blank"><img src={fileUrl(f.path)} alt={f.path.split('/').pop()} loading="lazy" /></a><figcaption>{f.path}</figcaption></figure>)}</div>
    <h2 id="portfolio">Existing project portfolio</h2>
    <p>The portfolio below preserves prior project reviews. Its historical statuses do not establish parity for the current reconstruction above.</p>
    {portfolio ? <><p><a href={fileUrl(portfolio.entry)} target="_blank">Open full portfolio</a></p><iframe title="Project portfolio" src={fileUrl(portfolio.entry)} sandbox="allow-scripts allow-downloads" /></> : <p>This project has no portfolio declared.</p>}
  </div>
</Layout>
<style>
  .portfolio { max-width: 1440px; margin: auto; padding: 28px; }
  nav { margin: 24px 0; } h2 { margin-top: 40px; scroll-margin-top: 24px; }
  .review-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,420px),1fr)); gap: 20px; }
  .review-card, figure { margin: 0; padding: 16px; border: 1px solid #586477; border-radius: 12px; }
  .model { height: 360px; position: relative; }
  .model :global(.viewport) { width: 100%; height: 100%; min-height: 0; }
  .download { display: inline-block; margin-right: 18px; }
  img { width: 100%; max-height: 500px; object-fit: contain; background: white; }
  figcaption { overflow-wrap: anywhere; margin-top: 10px; font-size: .85rem; }
  iframe { width: 100%; height: 1100px; border: 1px solid #586477; border-radius: 12px; background: white; }
</style>
